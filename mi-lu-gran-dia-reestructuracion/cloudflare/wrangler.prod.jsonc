{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "migrandia-api",
  "main": "migrandia-worker.js",
  "compatibility_date": "2026-09-26",
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RSVP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
